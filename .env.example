# ==============================================================================
# WebLingo Platform Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development | production | test)

NODE_ENV=development
APP_URL=http://localhost:3000
# Public URL clients use to reach this server (used for the widget embed snippet).
# Must be reachable by the end client's browser, e.g. http://192.168.0.229:3000
NEXT_PUBLIC_APP_URL=http://192.168.0.229:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weblingo
JWT_SECRET=Complicated@77889900112233445566


# (Optional Reference) MySQL / MariaDB connection for cPanel deployments
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=weblingo_db
# MYSQL_USER=weblingo_user
# MYSQL_PASSWORD=taha1234

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_64_char_string
SESSION_COOKIE_NAME=weblingo_session
COOKIE_SECURE=false

# Self-Hosted Translation Microservice Configuration
TRANSLATION_ENGINE_URL=http://127.0.0.1:5005
TRANSLATION_ENGINE_SECRET=generate_internal_service_secret_token
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_MAX_BATCH_SIZE=25

# Web Extraction Limits & SSRF Protection
EXTRACTION_TIMEOUT_MS=10000
EXTRACTION_MAX_SIZE_BYTES=5242880
ALLOW_PRIVATE_IPS=false
# Exact private hosts may be allowed without enabling all private IPs.
# Include the port when the service uses a non-default port, e.g. 192.168.0.229:3000
EXTRACTION_ALLOWED_PRIVATE_HOSTS=

# Self-hosted LibreTranslate (optional, free, open-source neural MT)
# Run: docker run -d -p 5000:5000 libretranslate/libretranslate
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=

# Strict Zero Paid API Policy
# Note: Google, DeepL, and AWS translation keys are strictly prohibited.

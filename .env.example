# ==============================================================================
# WebLingo configuration. Copy to .env for local development; on Netlify set the
# same variables in Site configuration -> Environment variables.
# Never commit real values.
# ==============================================================================

# --- Required -----------------------------------------------------------------

# PostgreSQL connection (local Postgres, Neon, Supabase...). Neon: use the pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weblingo

# Session signing secret, 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your LibreTranslate server (it does not run on Netlify). Use HTTPS in production
# if the server supports it. Example: http://117.102.7.15:8089
LIBRETRANSLATE_URL=
# Only when your LibreTranslate server has API keys enabled (--api-keys).
LIBRETRANSLATE_API_KEY=

# --- Recommended --------------------------------------------------------------

# Public URL of this WebLingo deployment, used in the generated <script> snippet
# when the dashboard is opened from localhost. On Netlify set it to your site URL,
# e.g. https://weblingo.netlify.app (no trailing slash).
NEXT_PUBLIC_APP_URL=

# --- Optional tuning ----------------------------------------------------------

# Per LibreTranslate HTTP request timeout and max segments per request.
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_MAX_BATCH_SIZE=25
# Time each translation step may use. Keep below your host's function limit
# (Netlify: 10 s default -> 7000; 26 s plan -> up to 20000).
JOB_STEP_BUDGET_MS=7000
# Initial estimate of LibreTranslate ms per segment (adapts automatically).
TRANSLATION_MS_PER_SEGMENT=700

# Website fetching limits.
EXTRACTION_TIMEOUT_MS=6000
EXTRACTION_MAX_SIZE_BYTES=5242880
MAX_PAGES_PER_SITE=25
# Cap on strings the widget may report per project (JavaScript-rendered text).
MAX_STRINGS_PER_PROJECT=20000

# SSRF protection: private network addresses are blocked. Allow exact host:port
# entries here (comma separated) for sites on your LAN, e.g. 192.168.0.229:8080
EXTRACTION_ALLOWED_PRIVATE_HOSTS=
# Allows ALL private network addresses. Do not enable on a shared server.
ALLOW_PRIVATE_IPS=false

# --- Access control -----------------------------------------------------------

# true = dashboard APIs require sign-in and project ownership (multi-user).
# false (default) = single-owner dashboard: anyone who can open it can use it.
REQUIRE_AUTH=false
# true = the widget only works on domains listed for the project.
WIDGET_REQUIRE_DOMAINS=false
# Allow POST /api/reset-database in production (signed-in users only).
ALLOW_DB_RESET=false
